{
	"name": "medusa-plugin-packeta",
	"version": "0.1.0",
	"description": "Packeta (Zásilkovna) fulfillment provider for Medusa v2 — pickup points, Z-BOX, home delivery, COD, labels, tracking, returns",
	"keywords": [
		"czech",
		"fulfillment",
		"medusa",
		"medusa-plugin",
		"medusa-plugin-fulfillment",
		"medusa-plugin-integration",
		"medusa-plugin-shipping",
		"medusa-v2",
		"packeta",
		"pickup-point",
		"shipping",
		"slovak",
		"zasilkovna",
		"zásilkovna"
	],
	"homepage": "https://github.com/radosek/medusa-plugin-packeta#readme",
	"bugs": {
		"url": "https://github.com/radosek/medusa-plugin-packeta/issues"
	},
	"license": "MIT",
	"author": "Radoš",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/radosek/medusa-plugin-packeta.git"
	},
	"files": [
		".medusa/server",
		"!.medusa/server/src/**/__tests__"
	],
	"type": "commonjs",
	"exports": {
		"./package.json": "./package.json",
		"./workflows": "./.medusa/server/src/workflows/index.js",
		"./widget": {
			"types": "./.medusa/server/src/widget/index.d.ts",
			"default": "./.medusa/server/src/widget/index.js"
		},
		"./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
		"./modules/*": "./.medusa/server/src/modules/*/index.js",
		"./providers/*": "./.medusa/server/src/providers/*/index.js",
		"./admin": {
			"import": "./.medusa/server/src/admin/index.mjs",
			"require": "./.medusa/server/src/admin/index.js",
			"default": "./.medusa/server/src/admin/index.js"
		},
		"./*": "./.medusa/server/src/*.js"
	},
	"scripts": {
		"build": "NODE_ENV=production medusa plugin:build",
		"watch": "medusa plugin:develop",
		"plugin:build": "NODE_ENV=production medusa plugin:build",
		"plugin:develop": "medusa plugin:develop",
		"plugin:publish": "medusa plugin:publish",
		"plugin:db:generate": "medusa plugin:db:generate",
		"typecheck": "tsc -p tsconfig.test.json --noEmit",
		"lint": "oxlint",
		"format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore .",
		"format:check": "oxfmt --check --ignore-path .gitignore --ignore-path .oxfmtignore .",
		"check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
		"test": "jest --passWithNoTests src",
		"test:integration": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.integration.config.js --runInBand --forceExit",
		"smoke": "node --import tsx scripts/smoke.ts",
		"prepare": "lefthook install",
		"prepublishOnly": "bun run check && bun run plugin:build"
	},
	"devDependencies": {
		"@medusajs/admin-sdk": "2.19.0",
		"@medusajs/cli": "2.19.0",
		"@medusajs/framework": "2.19.0",
		"@medusajs/icons": "2.19.0",
		"@medusajs/medusa": "2.19.0",
		"@medusajs/test-utils": "2.19.0",
		"@medusajs/ui": "4.2.1",
		"@mikro-orm/cli": "6.6.14",
		"@mikro-orm/core": "6.6.14",
		"@mikro-orm/knex": "6.6.14",
		"@mikro-orm/migrations": "6.6.14",
		"@mikro-orm/postgresql": "6.6.14",
		"@swc/core": "^1.15.47",
		"@types/jest": "^29.5.12",
		"@types/node": "^20.11.0",
		"@types/react": "^18.3.2",
		"@types/react-dom": "^18.2.25",
		"jest": "^29.7.0",
		"lefthook": "^2.1.10",
		"oxfmt": "^0.61.0",
		"oxlint": "^1.76.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"ts-jest": "^29.4.12",
		"tsx": "^4.23.1",
		"typescript": "^5.4.5",
		"vite": "^5.2.11"
	},
	"peerDependencies": {
		"@medusajs/admin-sdk": "2.x",
		"@medusajs/framework": "2.x",
		"@medusajs/icons": "2.x",
		"@medusajs/medusa": "2.x",
		"@medusajs/ui": ">=4.0.0"
	},
	"engines": {
		"node": "^20.19.0 || ^22.12.0 || >=24"
	},
	"trustedDependencies": [
		"@medusajs/telemetry",
		"@swc/core",
		"esbuild",
		"lefthook",
		"protobufjs"
	]
}
