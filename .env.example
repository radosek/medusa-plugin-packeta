# Packeta client section → Support → API password (32 hex) and API key (16 chars)
PACKETA_API_PASSWORD=
PACKETA_API_KEY=
# Sender indication (client section → Senders). Use a dedicated test sender while integrating.
PACKETA_ESHOP=
# Issued by integrations@packeta.com when you register the push-tracking webhook URL
PACKETA_WEBHOOK_SIGNING_KEY=

# Only for `medusa plugin:db:generate` (local Postgres to diff migrations against)
DB_USERNAME=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
